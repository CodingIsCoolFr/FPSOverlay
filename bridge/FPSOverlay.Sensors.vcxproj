<?xml version="1.0" encoding="utf-8"?>
<!-- C++/CLI bridge to LibreHardwareMonitor. Builds against the .NET Framework 4.x that ships with
     Windows, so no .NET developer pack is needed (FrameworkPathOverride points at the runtime). -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup>
    <!-- Lets the project build on its own (msbuild on this .vcxproj alone) as well as from the .sln. -->
    <SolutionDir Condition="'$(SolutionDir)'=='' or '$(SolutionDir)'=='*Undefined*'">$(MSBuildThisFileDirectory)..\</SolutionDir>
  </PropertyGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{6F0B1C2E-8A3D-4E5F-9B6A-7C8D9E0F1A2B}</ProjectGuid>
    <Keyword>ManagedCProj</Keyword>
    <RootNamespace>FPSOverlaySensors</RootNamespace>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <FrameworkPathOverride>$(WinDir)\Microsoft.NET\Framework64\v4.0.30319</FrameworkPathOverride>
    <BypassFrameworkInstallChecks>true</BypassFrameworkInstallChecks>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CLRSupport>true</CLRSupport>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(SolutionDir)build\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\obj\$(Configuration)\Sensors\</IntDir>
    <TargetName>FPSOverlay.Sensors</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <AdditionalUsingDirectories>$(SolutionDir)libs\lhwm;%(AdditionalUsingDirectories)</AdditionalUsingDirectories>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <!-- mscoree.lib (needed by /clr) is normally in the .NET developer pack. It is made here
           from mscoree.def instead, so neither the pack nor a copy of the library is needed. -->
      <AdditionalLibraryDirectories>$(IntDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <PreLinkEvent>
      <Command>lib.exe /nologo /machine:x64 /def:"$(ProjectDir)mscoree.def" /out:"$(IntDir)mscoree.lib"</Command>
      <Message>Making mscoree.lib</Message>
    </PreLinkEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="lhm_bridge.cpp" />
    <ClInclude Include="lhm_bridge.h" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
