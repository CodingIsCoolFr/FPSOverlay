<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup>
    <SolutionDir Condition="'$(SolutionDir)'=='' or '$(SolutionDir)'=='*Undefined*'">$(MSBuildThisFileDirectory)</SolutionDir>
    <!-- msbuild /p:FpsoAsInvoker=true builds a copy that does not ask for admin (UI work, screenshots). -->
    <FpsoAsInvoker Condition="'$(FpsoAsInvoker)'==''">false</FpsoAsInvoker>
  </PropertyGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <RootNamespace>FPSOverlay</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir Condition="'$(FpsoAsInvoker)'!='true'">$(SolutionDir)build\$(Configuration)\</OutDir>
    <OutDir Condition="'$(FpsoAsInvoker)'=='true'">$(SolutionDir)build\$(Configuration)-user\</OutDir>
    <IntDir>$(SolutionDir)build\obj\$(Configuration)\App$(FpsoAsInvoker)\</IntDir>
    <TargetName>FPSOverlay</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalIncludeDirectories>$(ProjectDir)src;$(ProjectDir)libs\RTLScript;$(ProjectDir)libs\imgui;$(ProjectDir)libs\imgui\backends;$(ProjectDir)libs\miniz;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;_WINDOWS;RTL_SCRIPT_ENABLE_FARSI;RTL_SCRIPT_ENABLE_HEBREW;RTL_SCRIPT_RAII_ENABLE_FARSI;RTL_SCRIPT_RAII_ENABLE_HEBREW;IMGUI_DISABLE_OBSOLETE_FUNCTIONS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
    <Manifest>
      <AdditionalManifestFiles>$(ProjectDir)src\app.manifest;%(AdditionalManifestFiles)</AdditionalManifestFiles>
    </Manifest>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>d3d11.lib;dxgi.lib;dwmapi.lib;pdh.lib;version.lib;shcore.lib;comctl32.lib;winhttp.lib;windowscodecs.lib;opengl32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <EnableUAC>true</EnableUAC>
      <UACExecutionLevel Condition="'$(FpsoAsInvoker)'!='true'">RequireAdministrator</UACExecutionLevel>
      <UACExecutionLevel Condition="'$(FpsoAsInvoker)'=='true'">AsInvoker</UACExecutionLevel>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Static CRT: the app runs on a clean Windows install with no VC++ redistributable. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\main.cpp" />
    <ClCompile Include="src\app\app.cpp" />
    <ClCompile Include="src\app\config.cpp" />
    <ClCompile Include="src\app\devtools.cpp" />
    <ClCompile Include="src\app\ini.cpp" />
    <ClCompile Include="src\app\log.cpp" />
    <ClCompile Include="src\app\release_info.cpp" />
    <ClCompile Include="src\app\updater.cpp" />
    <ClCompile Include="src\capture\frame_capture.cpp" />
    <ClCompile Include="src\capture\frame_stats.cpp" />
    <ClCompile Include="src\capture\target_tracker.cpp" />
    <ClCompile Include="src\locale\locale.cpp" />
    <ClCompile Include="src\locale\rtl_shape.cpp" />
    <ClCompile Include="src\platform\shell.cpp" />
    <ClCompile Include="src\platform\win_util.cpp" />
    <ClCompile Include="src\render\d3d.cpp" />
    <ClCompile Include="src\sensors\cpu_direct.cpp" />
    <ClCompile Include="src\sensors\gpu_adapters.cpp" />
    <ClCompile Include="src\sensors\lhm_select.cpp" />
    <ClCompile Include="src\sensors\nvml_reader.cpp" />
    <ClCompile Include="src\sensors\pawnio.cpp" />
    <ClCompile Include="src\sensors\pdh_reader.cpp" />
    <ClCompile Include="src\sensors\sensor_hub.cpp" />
    <ClCompile Include="src\ui\hud.cpp" />
    <ClCompile Include="src\ui\settings_window.cpp" />
    <ClCompile Include="src\ui\theme.cpp" />
    <ClCompile Include="src\ui\widgets.cpp" />
    <ClCompile Include="libs\RTLScript\RTLScript\RTLScript.cpp"><WarningLevel>Level1</WarningLevel></ClCompile>
    <ClCompile Include="libs\RTLScript\RTLScript\RTLScript-RAII.cpp"><WarningLevel>Level1</WarningLevel></ClCompile>
    <ClCompile Include="libs\imgui\imgui.cpp"><WarningLevel>Level3</WarningLevel></ClCompile>
    <ClCompile Include="libs\imgui\imgui_draw.cpp"><WarningLevel>Level3</WarningLevel></ClCompile>
    <ClCompile Include="libs\imgui\imgui_tables.cpp"><WarningLevel>Level3</WarningLevel></ClCompile>
    <ClCompile Include="libs\imgui\imgui_widgets.cpp"><WarningLevel>Level3</WarningLevel></ClCompile>
    <ClCompile Include="libs\imgui\backends\imgui_impl_dx11.cpp"><WarningLevel>Level3</WarningLevel></ClCompile>
    <ClCompile Include="libs\imgui\backends\imgui_impl_win32.cpp"><WarningLevel>Level3</WarningLevel></ClCompile>
    <!-- Unpacks downloaded updates; updater.cpp includes miniz.h with the same switches. -->
    <ClCompile Include="libs\miniz\miniz.c">
      <WarningLevel>Level1</WarningLevel>
      <PreprocessorDefinitions>MINIZ_NO_STDIO;MINIZ_NO_TIME;MINIZ_NO_ARCHIVE_WRITING_APIS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="src\app\app.h" />
    <ClInclude Include="src\app\config.h" />
    <ClInclude Include="src\app\devtools.h" />
    <ClInclude Include="src\app\ini.h" />
    <ClInclude Include="src\app\log.h" />
    <ClInclude Include="src\app\updater.h" />
    <ClInclude Include="src\app\version.h" />
    <ClInclude Include="src\capture\frame_capture.h" />
    <ClInclude Include="src\capture\frame_stats.h" />
    <ClInclude Include="src\capture\target_tracker.h" />
    <ClInclude Include="src\locale\locale.h" />
    <ClInclude Include="src\locale\rtl_shape.h" />
    <ClInclude Include="src\platform\shell.h" />
    <ClInclude Include="src\platform\win_util.h" />
    <ClInclude Include="src\render\d3d.h" />
    <ClInclude Include="src\sensors\gpu_adapters.h" />
    <ClInclude Include="src\sensors\lhm_select.h" />
    <ClInclude Include="src\sensors\nvml_reader.h" />
    <ClInclude Include="src\sensors\pawnio.h" />
    <ClInclude Include="src\sensors\pdh_reader.h" />
    <ClInclude Include="src\sensors\sensor_hub.h" />
    <ClInclude Include="src\sensors\snapshot.h" />
    <ClInclude Include="src\ui\hud.h" />
    <ClInclude Include="src\ui\settings_window.h" />
    <ClInclude Include="src\ui\theme.h" />
    <ClInclude Include="src\ui\widgets.h" />
    <ClInclude Include="bridge\lhm_bridge.h" />
  </ItemGroup>

  <ItemGroup>
    <ResourceCompile Include="src\resource.rc" />
    <Manifest Include="src\app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="bridge\FPSOverlay.Sensors.vcxproj">
      <Project>{6F0B1C2E-8A3D-4E5F-9B6A-7C8D9E0F1A2B}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>

  <!-- Everything the exe needs at runtime ends up next to it. -->
  <ItemGroup>
    <RuntimeFile Include="$(ProjectDir)libs\lhwm\lhwm-wrapper.dll" />
    <RuntimeFile Include="$(ProjectDir)libs\lhwm\PawnIO_setup.exe" />
    <RuntimeFile Include="$(ProjectDir)LICENSE.txt" />
    <RuntimeFile Include="$(ProjectDir)NOTICE.md" Condition="Exists('$(ProjectDir)NOTICE.md')" />
    <LocaleFile Include="$(ProjectDir)locales\*.json" />
  </ItemGroup>
  <Target Name="CopyRuntimeFiles" AfterTargets="Build">
    <Copy SourceFiles="@(RuntimeFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LocaleFile)" DestinationFolder="$(OutDir)locales" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(SolutionDir)build\$(Configuration)\FPSOverlay.Sensors.dll" DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" Condition="'$(FpsoAsInvoker)'=='true' and Exists('$(SolutionDir)build\$(Configuration)\FPSOverlay.Sensors.dll')" />
  </Target>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
